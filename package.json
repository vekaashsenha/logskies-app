{
  "name": "logskies-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@logskies/web",
    "dev:android": "npm run android --workspace=@logskies/mobile",
    "build:web": "npm run build --workspace=@logskies/web",
    "lint": "npm run lint --workspace=@logskies/web",
    "typecheck:mobile": "npm exec --workspace=@logskies/mobile -- tsc --noEmit",
    "test": "node --experimental-strip-types --test packages/domain/domain.test.ts packages/telemetry/*.test.ts scripts/security.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
